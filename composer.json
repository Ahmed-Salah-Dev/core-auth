{
    "name": "ahmed-salah-dev/core-auth",
    "description": "Core authentication package for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Salah",
            "email": "ahmed.a.salah24@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.65"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "AhmedSalahDev\\CoreAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhmedSalahDev\\CoreAuth\\CoreAuthServiceProvider"
            ]
        }
    }
}
